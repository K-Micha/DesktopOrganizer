<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DesktopOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopOrganizer"
        Width="620"
        Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>

        <!-- Outer Shadow -->
        <Path Width="500"
              Height="60"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Fill"
              Fill="#16000000"
              Stroke="Transparent"
              StrokeLineJoin="Miter"
              StrokeMiterLimit="10"
              Data="M 30,0 L 470,0 L 500,30 L 470,60 L 30,60 L 0,30 Z">

            <Path.Effect>
                <DropShadowEffect Color="#CC000000"
                                  BlurRadius="28"
                                  ShadowDepth="0"
                                  Opacity="0.32"/>
            </Path.Effect>

        </Path>


        <!-- MAIN ISLAND -->
        <Grid x:Name="Island"
              Width="500"
              Height="60"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Cursor="Hand"
              MouseLeftButtonDown="Island_MouseLeftButtonDown">


            <!-- Glass (denser now) -->
            <Path Stretch="Fill"
                  StrokeThickness="1.5"
                  StrokeLineJoin="Miter"
                  StrokeMiterLimit="10"
                  Data="M 30,0 L 470,0 L 500,30 L 470,60 L 30,60 L 0,30 Z">

                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">

                        <GradientStop Color="#B0151D26"
                                      Offset="0"/>

                        <GradientStop Color="#9010161E"
                                      Offset="0.50"/>

                        <GradientStop Color="#A810171F"
                                      Offset="1"/>

                    </LinearGradientBrush>
                </Path.Fill>

                <!-- BLUE → WHITE → ORANGE -->
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0.5"
                                         EndPoint="1,0.5">

                        <GradientStop Color="#FF56C8FF"
                                      Offset="0"/>

                        <GradientStop Color="#FF89DAFF"
                                      Offset="0.22"/>

                        <GradientStop Color="#FFF5FAFF"
                                      Offset="0.50"/>

                        <GradientStop Color="#FFFFD6C0"
                                      Offset="0.72"/>

                        <GradientStop Color="#FFFF8147"
                                      Offset="1"/>

                    </LinearGradientBrush>
                </Path.Stroke>

            </Path>


            <!-- Inner Rim -->
            <Path Margin="2"
                  Stretch="Fill"
                  Fill="Transparent"
                  StrokeThickness="1"
                  StrokeLineJoin="Miter"
                  StrokeMiterLimit="10"
                  Data="M 30,0 L 470,0 L 500,30 L 470,60 L 30,60 L 0,30 Z">

                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0.5"
                                         EndPoint="1,0.5">

                        <GradientStop Color="#305ECFFF"
                                      Offset="0"/>

                        <GradientStop Color="#28FFFFFF"
                                      Offset="0.50"/>

                        <GradientStop Color="#30FF9560"
                                      Offset="1"/>

                    </LinearGradientBrush>
                </Path.Stroke>

            </Path>


            <!-- CONTENT -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">


                <!-- WEATHER -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Viewbox Width="32"
                             Height="32">

                        <Canvas Width="32"
                                Height="32">

                            <Line X1="21"
                                  Y1="1"
                                  X2="21"
                                  Y2="4"
                                  Stroke="#EAF9FF"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

                            <Line X1="27"
                                  Y1="4"
                                  X2="25"
                                  Y2="6.5"
                                  Stroke="#EAF9FF"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

                            <Line X1="30"
                                  Y1="10"
                                  X2="27"
                                  Y2="10.5"
                                  Stroke="#EAF9FF"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

                            <Ellipse Canvas.Left="16"
                                     Canvas.Top="2"
                                     Width="10"
                                     Height="10"
                                     Stroke="#EAF9FF"
                                     StrokeThickness="1.6"/>

                            <Path Data="M 5,22
                                        C 5,18 8,15 12,15
                                        C 13,11 17,9 21,10
                                        C 25,11 27,14 27,17
                                        C 30,18 31,20 31,23
                                        C 31,27 28,29 24,29
                                        L 12,29
                                        C 8,29 5,26 5,22 Z"
                                  Fill="Transparent"
                                  Stroke="#EAF9FF"
                                  StrokeThickness="1.8"/>

                        </Canvas>

                        <Viewbox.Effect>
                            <DropShadowEffect Color="#FF43C4FF"
                                              BlurRadius="9"
                                              ShadowDepth="0"
                                              Opacity="0.90"/>
                        </Viewbox.Effect>

                    </Viewbox>


                    <StackPanel VerticalAlignment="Center"
                                Margin="8,0,0,0">

                        <TextBlock x:Name="WeatherText"
                                   Text="18°"
                                   Foreground="#EAF8FF"
                                   FontFamily="Bahnschrift"
                                   FontSize="22"
                                   FontWeight="SemiBold">

                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF42BDFF"
                                                  BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Opacity="0.90"/>
                            </TextBlock.Effect>

                        </TextBlock>

                        <TextBlock x:Name="LocationText"
                                   Text="S A L Z B U R G"
                                   Foreground="#D5E8F2"
                                   FontFamily="Bahnschrift"
                                   FontSize="10"
                                   FontWeight="Light"/>

                    </StackPanel>

                </StackPanel>


                <!-- BLUE DIVIDER -->
                <Border Width="1"
                        Height="30"
                        Margin="26,0"
                        VerticalAlignment="Center"
                        Background="#AA61CFFF">

                    <Border.Effect>
                        <DropShadowEffect Color="#FF42BDFF"
                                          BlurRadius="8"
                                          ShadowDepth="0"
                                          Opacity="0.90"/>
                    </Border.Effect>

                </Border>


                <!-- CPU -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="C P U"
                               Foreground="#E3EEF6"
                               FontFamily="Bahnschrift"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center">

                        <TextBlock.Effect>
                            <DropShadowEffect Color="#7757BFFF"
                                              BlurRadius="5"
                                              ShadowDepth="0"
                                              Opacity="0.55"/>
                        </TextBlock.Effect>

                    </TextBlock>


                    <TextBlock x:Name="CpuText"
                               Text="--%"
                               Foreground="#F0F9FF"
                               FontFamily="Bahnschrift"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center">

                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF42B8FF"
                                              BlurRadius="9"
                                              ShadowDepth="0"
                                              Opacity="0.95"/>
                        </TextBlock.Effect>

                    </TextBlock>

                </StackPanel>


                <!-- ORANGE DIVIDER -->
                <Border Width="1"
                        Height="30"
                        Margin="26,0"
                        VerticalAlignment="Center"
                        Background="#AAFF9660">

                    <Border.Effect>
                        <DropShadowEffect Color="#FFFF7840"
                                          BlurRadius="8"
                                          ShadowDepth="0"
                                          Opacity="0.90"/>
                    </Border.Effect>

                </Border>


                <!-- MEDIA -->
                <StackPanel x:Name="MediaStatus"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Visible">

                    <Viewbox Width="26"
                             Height="26">

                        <Canvas Width="30"
                                Height="30">

                            <Path Data="M 12,5 L 24,2 L 24,18 M 12,5 L 12,21"
                                  Stroke="#FFF4EC"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>

                            <Ellipse Canvas.Left="5"
                                     Canvas.Top="19"
                                     Width="8"
                                     Height="6"
                                     Fill="Transparent"
                                     Stroke="#FFF4EC"
                                     StrokeThickness="2"/>

                            <Ellipse Canvas.Left="17"
                                     Canvas.Top="16"
                                     Width="8"
                                     Height="6"
                                     Fill="Transparent"
                                     Stroke="#FFF4EC"
                                     StrokeThickness="2"/>

                        </Canvas>

                        <Viewbox.Effect>
                            <DropShadowEffect Color="#FFFF6F38"
                                              BlurRadius="9"
                                              ShadowDepth="0"
                                              Opacity="0.95"/>
                        </Viewbox.Effect>

                    </Viewbox>


                    <TextBlock x:Name="MediaText"
                               Text="LO-FI BEATS"
                               Foreground="#FFF1E9"
                               FontFamily="Bahnschrift"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               MaxWidth="140"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">

                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFFF7040"
                                              BlurRadius="8"
                                              ShadowDepth="0"
                                              Opacity="0.88"/>
                        </TextBlock.Effect>

                    </TextBlock>

                </StackPanel>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- LEFT BLUE — HOT INNER CORE (tight, intense)            -->
        <!-- ===================================================== -->

        <Path Width="500"
              Height="60"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Fill"
              Fill="Transparent"
              Stroke="#FF6AD0FF"
              StrokeThickness="1.5"
              StrokeLineJoin="Miter"
              StrokeMiterLimit="10"
              Data="M 30,0 L 470,0 L 500,30 L 470,60 L 30,60 L 0,30 Z"
              IsHitTestVisible="False">

            <Path.OpacityMask>
                <LinearGradientBrush StartPoint="0,0.5"
                                     EndPoint="1,0.5">

                    <GradientStop Color="White"
                                  Offset="0"/>

                    <GradientStop Color="#DDFFFFFF"
                                  Offset="0.18"/>

                    <GradientStop Color="#44FFFFFF"
                                  Offset="0.40"/>

                    <GradientStop Color="Transparent"
                                  Offset="0.55"/>

                </LinearGradientBrush>
            </Path.OpacityMask>

            <Path.Effect>
                <DropShadowEffect Color="#FF38BFFF"
                                  BlurRadius="6"
                                  ShadowDepth="0"
                                  Opacity="1.0"/>
            </Path.Effect>

        </Path>


        <!-- ===================================================== -->
        <!-- LEFT BLUE — SOFT OUTER BLOOM (wider, hazier)           -->
        <!-- ===================================================== -->

        <Path Width="500"
              Height="60"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Fill"
              Fill="Transparent"
              Stroke="#CC52C9FF"
              StrokeThickness="2"
              StrokeLineJoin="Miter"
              StrokeMiterLimit="10"
              Data="M 30,0 L 470,0 L 500,30 L 470,60 L 30,60 L 0,30 Z"
              IsHitTestVisible="False">

            <Path.OpacityMask>
                <LinearGradientBrush StartPoint="0,0.5"
                                     EndPoint="1,0.5">

                    <GradientStop Color="White"
                                  Offset="0"/>

                    <GradientStop Color="#DDFFFFFF"
                                  Offset="0.18"/>

                    <GradientStop Color="#44FFFFFF"
                                  Offset="0.40"/>

                    <GradientStop Color="Transparent"
                                  Offset="0.55"/>

                </LinearGradientBrush>
            </Path.OpacityMask>

            <Path.Effect>
                <DropShadowEffect Color="#FF38BFFF"
                                  BlurRadius="24"
                                  ShadowDepth="0"
                                  Opacity="0.95"/>
            </Path.Effect>

        </Path>


        <!-- ===================================================== -->
        <!-- WHITE CENTER BORDER GLOW                               -->
        <!-- ===================================================== -->

        <Path Width="500"
              Height="60"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Fill"
              Fill="Transparent"
              Stroke="#CCFFFFFF"
              StrokeThickness="1.5"
              StrokeLineJoin="Miter"
              StrokeMiterLimit="10"
              Data="M 30,0 L 470,0 L 500,30 L 470,60 L 30,60 L 0,30 Z"
              IsHitTestVisible="False">

            <Path.OpacityMask>
                <LinearGradientBrush StartPoint="0,0.5"
                                     EndPoint="1,0.5">

                    <GradientStop Color="Transparent"
                                  Offset="0.20"/>

                    <GradientStop Color="#44FFFFFF"
                                  Offset="0.34"/>

                    <GradientStop Color="White"
                                  Offset="0.50"/>

                    <GradientStop Color="#44FFFFFF"
                                  Offset="0.66"/>

                    <GradientStop Color="Transparent"
                                  Offset="0.80"/>

                </LinearGradientBrush>
            </Path.OpacityMask>

            <Path.Effect>
                <DropShadowEffect Color="#DDFFFFFF"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.55"/>
            </Path.Effect>

        </Path>


        <!-- ===================================================== -->
        <!-- RIGHT ORANGE — HOT INNER CORE (tight, intense)         -->
        <!-- ===================================================== -->

        <Path Width="500"
              Height="60"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Fill"
              Fill="Transparent"
              Stroke="#FFFFA366"
              StrokeThickness="1.5"
              StrokeLineJoin="Miter"
              StrokeMiterLimit="10"
              Data="M 30,0 L 470,0 L 500,30 L 470,60 L 30,60 L 0,30 Z"
              IsHitTestVisible="False">

            <Path.OpacityMask>
                <LinearGradientBrush StartPoint="0,0.5"
                                     EndPoint="1,0.5">

                    <GradientStop Color="Transparent"
                                  Offset="0.45"/>

                    <GradientStop Color="#44FFFFFF"
                                  Offset="0.60"/>

                    <GradientStop Color="#DDFFFFFF"
                                  Offset="0.82"/>

                    <GradientStop Color="White"
                                  Offset="1"/>

                </LinearGradientBrush>
            </Path.OpacityMask>

            <Path.Effect>
                <DropShadowEffect Color="#FFFF6120"
                                  BlurRadius="6"
                                  ShadowDepth="0"
                                  Opacity="1.0"/>
            </Path.Effect>

        </Path>


        <!-- ===================================================== -->
        <!-- RIGHT ORANGE — SOFT OUTER BLOOM (wider, hazier)        -->
        <!-- ===================================================== -->

        <Path Width="500"
              Height="60"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Fill"
              Fill="Transparent"
              Stroke="#CCFF8848"
              StrokeThickness="2"
              StrokeLineJoin="Miter"
              StrokeMiterLimit="10"
              Data="M 30,0 L 470,0 L 500,30 L 470,60 L 30,60 L 0,30 Z"
              IsHitTestVisible="False">

            <Path.OpacityMask>
                <LinearGradientBrush StartPoint="0,0.5"
                                     EndPoint="1,0.5">

                    <GradientStop Color="Transparent"
                                  Offset="0.45"/>

                    <GradientStop Color="#44FFFFFF"
                                  Offset="0.60"/>

                    <GradientStop Color="#DDFFFFFF"
                                  Offset="0.82"/>

                    <GradientStop Color="White"
                                  Offset="1"/>

                </LinearGradientBrush>
            </Path.OpacityMask>

            <Path.Effect>
                <DropShadowEffect Color="#FFFF7138"
                                  BlurRadius="24"
                                  ShadowDepth="0"
                                  Opacity="0.9"/>
            </Path.Effect>

        </Path>

    </Grid>

</Window>